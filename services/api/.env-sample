DATABASE_USER=postgres
DATABASE_PASSWORD=ps
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db-name
SECRET_KEY="SOME_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=20
DEFAULT_PLANS="Free, Pro"
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Keep true outside explicit local HTTP development. Access and refresh cookies are HTTP-only.
COOKIE_SECURE=true
# Same-site deployments use lax. Cross-site deployments must set none, HTTPS, an explicit CORS origin,
# and use the CSRF cookie/header contract.
COOKIE_SAME_SITE=lax
# Optional shared cookie domain, for example .example.com
COOKIE_DOMAIN=
